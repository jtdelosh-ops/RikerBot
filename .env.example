# Required: Discord bot token from the Discord Developer Portal
DISCORD_TOKEN=

# Required for scheduled quotes:
# Comma-separated list of channels Riker is allowed to roam between.
# Right-click each Discord channel -> Copy Channel ID
# Example: RIKER_CHANNEL_IDS=111111111111111111,222222222222222222
RIKER_CHANNEL_IDS=

# Backwards compatibility: if RIKER_CHANNEL_IDS is blank, the bot will
# still accept the old single-channel setting below.
RIKER_CHANNEL_ID=

# Recommended while developing:
# Right-click your server -> Copy Server ID
# This makes slash-command updates appear quickly in that server.
DISCORD_GUILD_ID=

# Each hour, probability that Riker posts a quote.
# 0.70 = 70% each eligible hour during the 9 AM-9 PM Eastern window.
RIKER_QUOTE_CHANCE=0.70

# Chance that a successful spontaneous appearance uses a short AI-generated
# original remark instead of a static quote. Falls back to a quote if AI fails.
RIKER_GENERATED_REMARK_CHANCE=0.20

# Number of recently used static quotes to avoid repeating.
RIKER_RECENT_QUOTE_HISTORY_SIZE=10

# Optional: per-user cooldown for /riker advice, in seconds
RIKER_ADVICE_COOLDOWN_SECONDS=30

# Moderate ceiling for /riker advice. The persona still asks for concise replies.
RIKER_ADVICE_MAX_OUTPUT_TOKENS=500

# Optional: enables /riker advice
OPENAI_API_KEY=

# Cost-conscious default for a tiny Discord personality bot.
OPENAI_MODEL=gpt-5.6-luna
